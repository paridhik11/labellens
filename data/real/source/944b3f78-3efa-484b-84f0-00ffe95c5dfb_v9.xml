         <component>
            <section ID="Lae40124a-a5e2-4edd-be12-832436e40608">
               <id root="e7e54b32-ece2-40c3-a4fa-40c6b49905f8"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients</title>
               <text>
                  <paragraph>Benzalkonium Cl 0.13% w/w               </paragraph>
                  <paragraph>Lidocaine HCI 2.5% w/w           </paragraph>
               </text>
               <effectiveTime value="20261110"/>
               <component>
                  <section ID="ID_b66e8d5b-4da3-4fa1-8fdd-658fae57b111">
                     <id root="626d5d34-dea5-4353-83bd-33b566f533c5"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <title>Purpose </title>
                     <text>
                        <paragraph>First aid antiseptic</paragraph>
                        <paragraph>Pain relieving spray</paragraph>
                     </text>
                     <effectiveTime value="20261110"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="L19a93c15-91ba-49fb-b36c-b6d2f8d6bd88">
               <id root="e95a49cb-eb59-440c-9eab-a9a266d78707"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <paragraph>First aid to help prevent bacterial contamination or skin infection, and for temporary relief of pain and itching associated with minor:</paragraph>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>cuts</item>
                     <item>
                        <caption>•</caption>scrapes</item>
                     <item>
                        <caption>•</caption>burns</item>
                     <item>
                        <caption>•</caption>sunburn</item>
                     <item>
                        <caption>•</caption>skin irritations</item>
                  </list>
               </text>
               <effectiveTime value="20261110"/>
            </section>
         </component>
         <component>
            <section ID="L44be3003-87b3-4af4-92e4-8a627fc1c583">
               <id root="06e0776f-e9e9-48ac-bd9c-a0250322c911"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">​For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20200319"/>
               <component>
                  <section ID="L4c5300ef-2c35-46f1-88bf-e4bbb3be2d27">
                     <id root="c399c66e-2c22-454a-a49f-730f8ec21fd7"/>
                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>​Ask a doctor before use if you have</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>deep or puncture wounds</item>
                           <item>
                              <caption>•</caption>animal bites</item>
                           <item>
                              <caption>•</caption>serious burns</item>
                        </list>
                     </text>
                     <effectiveTime value="20200319"/>
                  </section>
               </component>
               <component>
                  <section ID="L7efd685d-59e3-420a-925e-7c1baef2f9f2">
                     <id root="d3ebf2e9-87af-47c7-9ea7-d4ce83748952"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product​</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>do not use in or near the eyes</item>
                           <item>
                              <caption>•</caption>do not apply over large area of the body or in large quantities</item>
                           <item>
                              <caption>•</caption>do not apply over raw surfaces or blistered areas</item>
                        </list>
                     </text>
                     <effectiveTime value="20200319"/>
                  </section>
               </component>
               <component>
                  <section ID="Lfce1bac4-45ae-495a-9a82-c2625d9b8b33">
                     <id root="99b05d6e-6528-49e7-98ca-006cc2612c50"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>​Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>condition worsens</item>
                           <item>
                              <caption>•</caption>symptoms persist for more than 7 days, or clear up and occur again within a few days</item>
                        </list>
                     </text>
                     <effectiveTime value="20200319"/>
                  </section>
               </component>
               <component>
                  <section ID="L353326a5-dd27-4113-88e1-7b9263e375ee">
                     <id root="426f7abc-bf85-4002-a808-8de9cc7e09bc"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>​Keep out of reach of children</title>
                     <text>
                        <paragraph>​If swallowed get medical help or contact a Poison Control Center right away at 1-800-222-1222</paragraph>
                     </text>
                     <effectiveTime value="20200319"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="L607790cb-388a-4214-803d-10e3ce9d5960">
               <id root="d06c0eb6-e8ae-4ecd-bc9a-95d8a99485b9"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">adults and children 2 years and older:</content> clean the affected area. spray small amount on the area 1-3 times daily; may be covered with sterile bandage (let dry first)</item>
                     <item>
                        <caption>•</caption>
                        <content styleCode="bold">children under 2 years:</content> ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20200319"/>
            </section>
         </component>
         <component>
            <section ID="Lec2c1b95-415a-41f2-9721-35c49b710745">
               <id root="1ca4a394-3c0c-4302-acc6-da08bc90384d"/>
               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>store at room temperature</item>
                     <item>
                        <caption>•</caption>avoid excessive heat</item>
                  </list>
               </text>
               <effectiveTime value="20200319"/>
            </section>
         </component>
