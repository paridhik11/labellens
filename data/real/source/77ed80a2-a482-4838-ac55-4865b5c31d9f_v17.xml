               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>read the directions and warnings before use</item>
                     <item>keep the carton. It contains important information.</item>
                     <item>store at 20-25°C (68-77°F) and protect from moisture</item>
                  </list>
               </text>
               <effectiveTime value="20110620"/>
            </section>
         </component>
