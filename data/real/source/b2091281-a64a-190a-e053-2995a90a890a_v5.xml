               <title>Directions</title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">do not take more than directed (see 
         
   
    <linkHtml href="#OD">Overdose warning</linkHtml>)
        
  
   </content>
                     </item>
                     <item>do not take more than 12 caplets in any 24-hour period</item>
                     <item>adults and children 12 years of age and older:  take 2 caplets every 4 hours</item>
                     <item>children under 12 years of age:  do not use</item>
                  </list>
               </text>
               <effectiveTime value="20190402"/>
            </section>
