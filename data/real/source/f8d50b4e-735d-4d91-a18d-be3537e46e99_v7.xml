               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Inactive ingredients</content>
                  </content>
               </title>
               <text>
                  <paragraph>anhydrous citric acid, FD&amp;C blue #1, FD&amp;C red #40, flavor, glycerin, high fructose corn syrup, propylene glycol, purified water, sodium benzoate, sodium chloride, sodium citrate dihydrate, sucralose, sucrose, xanthan gum</paragraph>
               </text>
               <effectiveTime value="20261028"/>
            </section>
         </component>
