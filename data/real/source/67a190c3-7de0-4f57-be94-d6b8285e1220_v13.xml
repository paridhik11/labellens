         <component>
            <section ID="LINK_64f28c92-ac83-44bf-9a89-da74e5f5db2c">
               <id root="b8e3aba7-46c9-4456-a108-1331d2eafb17"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Uses</content>
                  </content>
               </title>
               <text>
                  <paragraph>temporary relief of occasional headaches and minor aches and pains with accompanying sleeplessness<br/>
                  </paragraph>
               </text>
               <effectiveTime value="20261021"/>
            </section>
